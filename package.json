{
  "name": "@asafarim/progress-bars",
  "version": "0.6.3",
  "private": false,
  "type": "module",
  "description": "Accessible, themeable React progress bar components (linear, circular, step, segmented, threshold, vertical, spinner) built with CSS modules and design tokens.",
  "keywords": [
    "react",
    "react-components",
    "progress-bar",
    "progress",
    "linear-progress",
    "circular-progress",
    "spinner",
    "step-progress",
    "segmented-progress",
    "threshold-progress",
    "vertical-progress",
    "progress-legend",
    "progress-stack",
    "ui",
    "ui-components",
    "design-system",
    "design-tokens",
    "css-modules",
    "typescript",
    "accessible",
    "asafarim"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@asafarim/design-tokens": "^0.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "build": "pnpm run clean && pnpm run typecheck && vite build",
    "dev": "pnpm -C demo dev",
    "demo": "pnpm -C demo dev",
    "predemo": "pnpm install && pnpm run build",
    "deploy-demo": "cd demo && pnpm run deploy",
    "deploy": "pnpm run predemo && cd demo && pnpm run deploy-demo",
    "update-readme": "node ./scripts/update-readme-version.js",
    "release": "pnpm run update-readme && pnpm run build && node ./scripts/release.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Ali Safari <ali@asafarim.com> (https://asafarim.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alisafari-it/progress-bars.git",
    "directory": "."
  },
  "homepage": "https://alisafari-it.github.io/progress-bars",
  "bugs": {
    "url": "https://github.com/alisafari-it/progress-bars/issues",
    "email": "ali@asafarim.com"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://www.buymeacoffee.com/asafarim"
    }
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
